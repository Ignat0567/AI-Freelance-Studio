{
    "name": "ai-freelance-studio",
    "version": "1.0.0-beta.1",
    "description": "Desktop studio for creating, validating, and delivering small freelance software projects.",
    "author": "AI Labs",
    "copyright": "Copyright (C) 2026 AI Labs",
    "main": "main.js",
    "engines": {
        "node": ">=14.17.0"
    },
    "scripts": {
        "dev:vite": "vite --host",
        "build:vite": "vite build",
        "tailwind:build": "tailwindcss -i ./src/index.css -o ./dist/output.css --watch",
        "start": "electron .",
        "start:electron": "electron .",
        "dev:full": "npm run start:electron",
        "dev:lite": "vite --host",
        "validate:signing": "node scripts/validate-windows-signing.js",
        "predist:win": "npm run validate:signing",
        "prepackage:win": "npm run validate:signing",
        "dist:win": "electron-builder --win",
        "dist:mac": "electron-builder --mac",
        "dist:linux": "electron-builder --linux",
        "dist:all": "electron-builder --win --mac --linux",
        "build:backend": "python ../scripts/build_backend.py",
        "hash:win": "node scripts/write-installer-sha256.js",
        "package:win": "npm run build:vite && npm run build:backend && npm run dist:win && npm run hash:win"
    },
    "dependencies": {
        "@google/model-viewer": "^4.3.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^4.3.1",
        "autoprefixer": "^10.4.19",
        "concurrently": "^8.2.2",
        "electron": "^31.0.0",
        "electron-builder": "^24.13.3",
        "postcss": "^8.4.38",
        "tailwindcss": "^3.4.4",
        "vite": "^5.3.1",
        "wait-on": "^7.2.0"
    },
    "build": {
        "appId": "com.ailabs.freelancestudio",
        "productName": "AI Freelance Studio",
        "directories": {
            "output": "installers"
        },
        "files": [
            "dist/**/*",
            "main.js",
            "preload.js",
            "official-downloads.js",
            "backend-request-policy.js",
            "sandbox-test-lab-transport.js",
            "build/icon.ico",
            "../package.json",
            "!**/*.{pfx,p12,pem,key,cer,crt}"
        ],
        "extraResources": [
            {
                "from": "../backend_dist",
                "to": "backend",
                "filter": [
                    "**/*",
                    "!**/*.{pfx,p12,pem,key,cer,crt}"
                ]
            },
            {
                "from": "dist",
                "to": "frontend-dist",
                "filter": [
                    "**/*",
                    "!**/*.map"
                ]
            }
        ],
        "win": {
            "signAndEditExecutable": true,
            "executableName": "AI Freelance Studio",
            "target": [
                "nsis"
            ],
            "icon": "build/icon.ico",
            "artifactName": "${productName}-Setup-${version}-win.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "runAfterFinish": true,
            "createDesktopShortcut": true,
            "shortcutName": "AI Freelance Studio",
            "installerIcon": "build/icon.ico",
            "uninstallerIcon": "build/icon.ico",
            "uninstallDisplayName": "AI Freelance Studio ${version}",
            "include": "build/installer.nsh"
        },
        "mac": {
            "target": [
                "dmg"
            ],
            "icon": "build/icon.icns",
            "category": "public.app-category.developer-tools",
            "artifactName": "${productName}-${version}-mac.${ext}"
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "icon": "build/icon.png",
            "category": "Development",
            "artifactName": "${productName}-${version}-linux.${ext}"
        }
    }
}
