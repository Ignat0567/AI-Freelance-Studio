{
    "name": "ai-freelance-studio",
    "version": "1.0.0",
    "main": "main.js",
    "engines": {
        "node": ">=14.17.0"
    },
    "scripts": {
        "dev:vite": "vite --host",
        "build:vite": "vite build",
        "tailwind:build": "tailwindcss -i ./src/index.css -o ./dist/output.css --watch",
        "start": "electron .",
        "start:electron": "electron .",
        "dev:full": "npm run start:electron",
        "dev:lite": "vite --host",
        "dist:win": "electron-builder --win",
        "dist:mac": "electron-builder --mac",
        "dist:linux": "electron-builder --linux",
        "dist:all": "electron-builder --win --mac --linux"
    },
    "dependencies": {
        "@google/model-viewer": "^4.3.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^4.3.1",
        "autoprefixer": "^10.4.19",
        "concurrently": "^8.2.2",
        "electron": "^31.0.0",
        "electron-builder": "^24.13.3",
        "postcss": "^8.4.38",
        "tailwindcss": "^3.4.4",
        "vite": "^5.3.1",
        "wait-on": "^7.2.0"
    },
    "build": {
        "appId": "com.ailabs.freelancestudio",
        "productName": "AI Freelance Studio",
        "directories": {
            "output": "installers"
        },
        "files": [
            "dist/**/*",
            "main.js",
            "preload.js",
            "../main.py",
            "../ai_utils.py",
            "../ai_developer.py",
            "../docker_tester.py",
            "../goldie_agent.py",
            "../qa_engine.py",
            "../requirements_checker.py",
            "../search_utils.py",
            "../package.json",
            "../studio_config.json"
        ],
        "extraResources": [
            {
                "from": "../.venv",
                "to": ".venv",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "target": [
                "nsis"
            ],
            "icon": "build/icon.ico",
            "artifactName": "${productName}-Setup-${version}-win.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "runAfterFinish": true,
            "shortcutName": "AI Freelance Studio"
        },
        "mac": {
            "target": [
                "dmg"
            ],
            "icon": "build/icon.icns",
            "category": "public.app-category.developer-tools",
            "artifactName": "${productName}-${version}-mac.${ext}"
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "icon": "build/icon.png",
            "category": "Development",
            "artifactName": "${productName}-${version}-linux.${ext}"
        }
    }
}
