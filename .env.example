# FreelancerStudio Configuration
# Copy this file to .env and fill in your keys

# AI Provider API Keys
# SecretStore reads these from the process environment first.
# New secrets are not saved to studio_config.json.
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
GOOGLE_API_KEY=

# GitHub Integration (optional)
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_REPO=

# Server
BACKEND_START_PORT=8080
VITE_PORT=3000

# Ollama (local AI, optional)
OLLAMA_BASE_URL=http://localhost:11434/v1
