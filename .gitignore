*.egg

# Virtual environment
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swo
*.swp

# Project files
studio_config.json
projects_state.json
# order_workflow's opt-in persistence: real client orders and their execution event
# streams, written at runtime. Local state, and not ours to commit.
orders_state.json
order_executions_state.json
full_stack_spec.json
test_project.json

# Environment
.env
.env.local
.env.*
!.env.example

# Code-signing material must only come from environment variables or CI secrets.
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt

# Logs
*.log
*.err
server_*.txt
sv_*.log
sv_*.txt
server_test.*

# Node
frontend/node_modules/
frontend/dist/
frontend/installers/

# Cache
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local backups
local_backups/
.opencode_backups/
/backups/
/project_file_backups/

# OpenCode CLI local runtime/session state (not Studio source)
/.opencode/

# Local runtime state
/studio_port.txt
/sandbox-test-lab-jobs.json
/sandbox-test-lab-diagnostics/

# OS
Thumbs.db
.DS_Store

# Generated projects
generated_projects/*/
generated_projects/*.zip

# Packaged backend distribution (build output)
/backend_dist/

# Bundled ffmpeg binary (must be downloaded manually, see third_party/ffmpeg/PROVENANCE.md)
/third_party/ffmpeg/ffmpeg.exe
/third_party/ffmpeg/*.dll

# Generated QA and packaged-runtime evidence
/artifacts/

# Timestamped local backup snapshots
/backups/*_20[0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]/

# Conventional tool outputs
/frontend/dist-electron/
/test-results/
/playwright-report/

# Unreferenced duplicate of the canonical branding source
/AI_FreelanceStudio_Logo.png

# Claude Code local session state. Not Studio source: worktrees are full checkouts of
# this repository, launch.json carries absolute machine paths, and the rest is per-machine
# scheduling and session bookkeeping.
/.claude/

# Scratch files an interrupted run left in the repository root
/_tmp.json
/_logs.json
/.projects_state.json.*.tmp

# Legacy secret material. studio_config.json is already ignored; its migration backups
# carry the same credentials and must never be tracked either.
/studio_config.*.json.bak
