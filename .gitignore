# Python
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.egg-info/
dist/
build/
!frontend/build/
frontend/build/*
!frontend/build/installer.nsh
!frontend/build/icon.ico
!frontend/build/branding/
frontend/build/branding/*
!frontend/build/branding/ai-freelance-studio-source.png
